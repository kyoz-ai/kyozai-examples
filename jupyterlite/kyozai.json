{
  "$schema": "https://kyoz.ai/schemas/application-v1.json",
  "schemaVersion": 1,
  "build": {
    "kind": "jupyterlite",
    "contents": "files",
    "static": "site",
    "hooks": "hooks.js"
  },
  "artifacts": {
    "assets": "dist/assets"
  },
  "paths": {
    "learner": "/lab/index.html",
    "instructor": "/dashboard.html"
  },
  "capabilities": ["personal-objects", "application-database"],
  "database": {
    "migrations": [
      "migrations/001-notebook-progress.sql",
      "migrations/002-cell-executions.sql"
    ],
    "tables": {
      "notebook_progress": {
        "scope": "membership",
        "key": ["path"]
      },
      "cell_executions": {
        "scope": "membership",
        "key": ["path", "cell_id", "executed_at"]
      }
    }
  },
  "egress": {
    "browser": ["https://cdn.jsdelivr.net"]
  }
}
