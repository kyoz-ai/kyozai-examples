{
  "$schema": "https://kyoz.ai/schemas/application-v1.json",
  "schemaVersion": 1,
  "build": {
    "kind": "jupyterlite",
    "contents": "files",
    "static": "site",
    "hooks": "hooks.js"
  },
  "artifacts": {
    "assets": "dist/assets"
  },
  "paths": {
    "learner": "/lab/index.html",
    "instructor": "/dashboard.html"
  },
  "capabilities": ["personal-objects", "application-database"],
  "database": {
    "migrations": ["migrations/001-notebook-progress.sql"],
    "tables": {
      "notebook_progress": {
        "scope": "membership",
        "key": ["path"]
      }
    }
  },
  "egress": {
    "browser": ["https://cdn.jsdelivr.net"]
  }
}
